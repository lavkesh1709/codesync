# --- Database (Neon) ---
# Must use postgresql+asyncpg:// prefix for async SQLAlchemy
# Get from: Neon dashboard → Connection string → copy and replace postgresql:// with postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# --- Redis (Upstash) ---
# Must use rediss:// (double-s) for TLS — Upstash rejects plain redis://
# Get from: Upstash console → Redis → Connect → copy the rediss:// URL
REDIS_URL=rediss://default:token@host:6379

# --- Celery (uses same Upstash Redis as above) ---
CELERY_BROKER_URL=rediss://default:token@host:6379
CELERY_RESULT_BACKEND=rediss://default:token@host:6379

# --- Groq ---
# Get from: console.groq.com → API Keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- Cohere (embeddings) ---
# Get from: dashboard.cohere.com → API Keys
# Free tier: 100 calls/min, no credit card needed for trial key
COHERE_API_KEY=your_cohere_key_here

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Ingestion ---
MAX_FILE_SIZE_MB=1
CHUNK_SIZE_LINES=40
CHUNK_OVERLAP_LINES=5